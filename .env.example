# --- Radicale / CalDAV (the only calendar source) ---
# Base URL of the CalDAV server. Radicale's own config puts it on 5232.
RADICALE_URL=http://127.0.0.1:5232
RADICALE_USERNAME=me
RADICALE_PASSWORD=change_me
# Optional allow-list of calendars to read, by id, display name, or full URL.
# Leave unset to merge every calendar that accepts events; set it to hide the
# rest. The first entry is also where new events are created.
# RADICALE_CALENDAR_IDS=SqrtCal,Work
