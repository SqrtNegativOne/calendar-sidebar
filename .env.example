# --- Google Calendar (optional) ---
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8764/api/auth/callback
# leave GOOGLE_CALENDAR_ID unset to read every calendar; set it to pin the
# widget to a single calendar (e.g. primary)
# GOOGLE_CALENDAR_ID=primary

# --- Microsoft Calendar (optional) ---
# Register the redirect URI below under "Web" in the Azure app registration.
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:8764/api/auth/microsoft/callback
# "common" covers work/school + personal accounts; pin a tenant to restrict.
MICROSOFT_TENANT_ID=common
# leave MICROSOFT_CALENDAR_ID unset to read every calendar
# MICROSOFT_CALENDAR_ID=AQMkAD...
